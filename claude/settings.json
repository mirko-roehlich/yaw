{
  "permissions": {
    "allow": [
      "Bash(cd *)",
      "Bash(git *)",
      "Bash(gh *)",
      "Bash(node .claude/*)",
      "Bash(node \"$CLAUDE_PROJECT_DIR/.claude/*)"
    ],
    "deny": [
      "Bash(git push --no-verify*)",
      "Bash(git push * --no-verify*)",
      "Bash(git commit * --no-verify*)",
      "Bash(git push * main*)",
      "Bash(git push * +main*)",
      "Bash(git push * :main*)",
      "Bash(git -C * push * main*)",
      "Bash(git push * --delete main*)",
      "Bash(git branch -D main*)",
      "Bash(git branch -d main*)",
      "Bash(git worktree remove --force*)",
      "Bash(gh pr merge *)",
      "Bash(gh pr review *)",
      "Bash(gh repo delete*)",
      "Bash(gh api -X DELETE *)",
      "Bash(gh api --method DELETE *)",
      "Edit(.env*)"
    ],
    "additionalDirectories": [
      ".."
    ]
  },
  "hooks": {
    "WorktreeCreate": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/worktree-create.mjs\""
          }
        ]
      }
    ],
    "WorktreeRemove": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/worktree-remove.mjs\""
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/test-paths.mjs\""
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/subagent-stop.mjs\""
          }
        ]
      }
    ]
  }
}
